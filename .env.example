# Discord
DISCORD_TOKEN=
GUILD_ID=
BANK_USER_ID=
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=

# Dashboard — تسجيل الدخول بحساب ديسكورد (OAuth2)
# Developer Portal > OAuth2: انسخ Client Secret وأضف Redirect: <DASHBOARD_URL>/auth/callback
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=https://your-app.onrender.com
# أي نص عشوائي طويل (16+ حرف) لتوقيع الجلسات
SESSION_SECRET=
# الرتبة المسموح لها بدخول الداشبورد
DASHBOARD_ROLE_ID=1458271551907565618

# اختياري: يؤخذ تلقائيًا من البوت إذا ما تحدد
# DISCORD_CLIENT_ID=
# بادئة أوامر الستاف داخل التذاكر (الافتراضي $)
# STAFF_PREFIX=$
# المنفذ: ريندر يحدده تلقائيًا (PORT). للتشغيل المحلي فقط:
# PORT=3000

# ProBot
PROBOT_ID=282859044593598464
# القيمة الافتراضية لنسبة الضريبة (تتغير لاحقًا من الداشبورد > الإعدادات)
PROBOT_TAX_PERCENT=5
# مهلة الدفع بالمللي ثانية (اختياري — الافتراضي 120000 = دقيقتين)
# PAYMENT_TIMEOUT_MS=120000
# لوق تشخيصي لرسائل بروبوت (اختياري)
# DEBUG_TRANSFERS=true

# Supabase (استخدم service_role key)
SUPABASE_URL=
SUPABASE_KEY=
